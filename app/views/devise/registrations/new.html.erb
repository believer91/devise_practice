<h2>サインアップ画面</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  
  <div class="field">
  <%= f.label :name, "名前" %><br>
  <%= f.text_field :name, autofocus: true %>
</div>


  <div class="field">
    <%= f.label :email, "メールアドレス" %><br>
    <p><%= f.email_field :email, autocomplete: "email" %></p>
  </div>

  <div class="field">
  <%= f.label :password, "パスワード" %>
  <% if @minimum_password_length %>
    <em>（<%= @minimum_password_length %>文字以上）</em>
  <% end %>
  <br>
  <%= f.password_field :password, autocomplete: "new-password" %>
</div>

  <div class="field">
    <%= f.label :password_confirmation, "パスワードの確認" %><br>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit "サインアップ" %>
  </div>
<% end %>

<%= link_to "ログイン", new_user_session_path %><br>
<%= link_to "トップ画面に戻る", root_path %>
